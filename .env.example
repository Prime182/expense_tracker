# Copy to .env and fill in. .env is gitignored and must never be committed.

# Supabase Postgres connection string.
# Use the POOLER host from Supabase → Project Settings → Database → Connection string.
# The direct host (db.<ref>.supabase.co) is IPv6-only and Render dials out over IPv4,
# so the pooler is required in production and fine everywhere else.
#   Session mode  (port 5432): postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Transaction mode (port 6543) also works; prepared statements are already disabled for it.
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Required to create an account. Signup is refused unless this matches exactly.
# Leave unset only if you deliberately want signup open to anyone with the URL.
INVITE_CODE=change-me-to-something-unguessable

# Signs the session cookie. Changing it signs every user out.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
